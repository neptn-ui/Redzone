# .env.example — SIH26191 Risk-Aware Relocation Platform
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# .env is listed in .gitignore from day one (§15.1).
#
# -------------------------------------------------------

# ---- PostgreSQL / PostGIS --------------------------------
POSTGRES_USER=ndrf_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=red_zone

# ---- External APIs ----------------------------------------
# OpenWeatherMap (free tier — https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Anthropic (LLM narrative generation — https://www.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Copernicus / SentinelHub (Sentinel-1 and Sentinel-2)
# Register free at https://dataspace.copernicus.eu/
SENTINELHUB_CLIENT_ID=your_sentinelhub_client_id_here
SENTINELHUB_CLIENT_SECRET=your_sentinelhub_client_secret_here

# ---- Cache policy -----------------------------------------
# Number of hours before a cached API response is considered stale
# Increase before a demo to avoid live API calls on venue Wi-Fi
CACHE_FRESH_HOURS=12

# ---- Pilot region (Chamoli, Uttarakhand) ------------------
PILOT_LAT=30.45
PILOT_LON=79.55
PILOT_DISTRICT=Chamoli
PILOT_STATE=Uttarakhand
